# Copy to server/.env (never commit real values).
PORT=4000
DATABASE_PATH=./data/planora.db
# Comma-separated list of allowed browser origins (dev default shown).
CORS_ORIGINS=http://localhost:5173
# Optional. Leave empty to run in clearly-labelled deterministic fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
